{
    "permissions": {
      "allow": [
        "Edit",
        "Write",
        "Skill(ui-ux-pro-max)",
        "Bash(@.claude/skills/ui-ux-pro-max/scripts/*)",
        "Bash(xcrun simctl:*)",
        "Bash(dart:*)",
        "Bash(flutter:*)",
        "Bash(melos:*)",
        "Bash(mise:*)",
        "Bash(cat:*)",
        "Bash(xargs:*)",
        "Bash(dprint:*)",
        "Bash(git stash:*)",
        "Bash(git fetch:*)",
        "Bash(git push:*)",
        "Bash(git checkout:*)",
        "Bash(git merge develop)",
        "Bash(gh pr list:*)",
        "Bash(gh pr view:*)",
        "Bash(git gtr:*)"
      ],
      "deny": [],
      "defaultMode": "plan"
    },
    "env": {
      "ENABLE_TOOL_SEARCH": "true",
      "ENABLE_EXPERIMENTAL_MCP_CLI": "false"
    },
    "language": "japanese",
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "./scripts/update-pencil-port.sh"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "melos run format",
              "timeout": 60
            }
          ]
        }
      ]
    },
    "enabledPlugins": {
      "feature-dev@claude-plugins-official": true,
      "code-simplifier@claude-plugins-official": true
    }
  }
  